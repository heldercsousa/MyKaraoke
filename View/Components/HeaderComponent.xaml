<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:MyVocaList.View.Components"
             x:Class="MyVocaList.View.Components.HeaderComponent"
             x:Name="HeaderRoot">

    <Grid ColumnDefinitions="Auto,*,Auto"
          Padding="16,12,16,12"
          RowSpacing="0"
          ColumnSpacing="8">

        <!-- LEFT BUTTON CONTAINER (48x48dp MD3 Touch Target) -->
        <Grid Grid.Column="0"
              WidthRequest="48"
              HeightRequest="48"
              HorizontalOptions="Start"
              VerticalOptions="Center">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnLeftButtonClicked" />
            </Grid.GestureRecognizers>

            <!-- Back Arrow (List Mode) -->
            <components:StatefulIcon x:Name="backArrowImage"
                   IconName="arrow_back"/>

            <!-- Cancel Icon (Form Mode with Icon) -->
            <components:StatefulIcon x:Name="cancelIconImage"
                   IconName="close"/>

            <!-- Cancel Text (Form Mode with Text) -->
            <Label x:Name="cancelTextLabel"
                   Text="Cancelar"
                   TextColor="{StaticResource OnSurfaceVariant}"
                   FontSize="16"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"
                   LineBreakMode="NoWrap"
                   IsVisible="False" />
        </Grid>

        <HorizontalStackLayout Grid.Column="1"
            Spacing="8"
            HorizontalOptions="Center"
            VerticalOptions="Center">

            <components:StatefulIcon IconName="{Binding Source={x:Reference HeaderRoot}, Path=IconName}" />

            <Label x:Name="headerTitle"
               Text="{Binding Source={x:Reference HeaderRoot}, Path=Title}"
               Style="{StaticResource HeadlineMedium}"
               TextColor="{StaticResource OnBackground}"
               VerticalOptions="Center" />

        </HorizontalStackLayout>



        <!-- RIGHT BUTTON CONTAINER (48x48dp MD3 Touch Target) -->
        <Grid Grid.Column="2"
              x:Name="rightButtonStack"
              WidthRequest="48"
              HeightRequest="48"
              HorizontalOptions="End"
              VerticalOptions="Center"
              IsVisible="False">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnSaveButtonClicked" />
            </Grid.GestureRecognizers>

            <!-- Save Icon (Form Mode with Icon) -->
            <components:StatefulIcon x:Name="saveIconImage"
                   IconName="check"/>

            <!-- Save Text (Form Mode with Text) -->
            <Label x:Name="saveTextLabel"
                   Text="Salvar"
                   TextColor="{StaticResource Primary}"
                   FontSize="16"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"
                   LineBreakMode="NoWrap"
                   IsVisible="False" />
        </Grid>

        <!-- SPACER (When no right button is shown) -->
        <ContentView Grid.Column="2"
                     x:Name="rightSpacer"
                     WidthRequest="48"
                     IsVisible="True" />

    </Grid>
</ContentView>
