<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
			 xmlns:local="clr-namespace:MyVocaList.View"
			 xmlns:contracts="clr-namespace:MyVocaList.Contracts.DTOs.List;assembly=MyVocaList.Contracts"
			 xmlns:components="clr-namespace:MyVocaList.View.Components"
			 xmlns:domain="clr-namespace:MyVocaList.Domain;assembly=MyVocaList.Domain"
			 xmlns:behaviors="clr-namespace:MyVocaList.View.Behaviors"
			 x:Class="MyVocaList.View.SpotPage"
			 x:DataType="local:SpotPage"
			 BackgroundColor="{StaticResource Background}"
			 NavigationPage.HasNavigationBar="False">

    <ContentPage.Behaviors>
        <behaviors:SmartPageLifecycleBehavior
		    NavBar="{x:Reference CrudNavBar}"
		    MainContent="{x:Reference mainContentGrid}"
		    LoadDataCommand="{Binding LoadDataCommand}"
		    EnableAutoBypass="True"
		    MaxFailuresBeforeBypass="2" />

        <behaviors:SafeNavigationBehavior
            x:Name="SpotFormNavigationBehavior"
            TargetPageType="{x:Type local:SpotFormPage}"
            EnableSmartStackNavigation="False"
            DebounceMilliseconds="800" />

        <behaviors:SafeNavigationBehavior
		    x:Name="BackNavigationBehavior"
		    EnableSmartStackNavigation="True"
		    DebounceMilliseconds="500" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,*,Auto">
        <components:HeaderComponent Grid.Row="0" Title="Locais" />

        <!-- MAIN CONTENT (Grid 1) -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout x:Name="mainContentGrid" Style="{StaticResource PageContainer}">

                <!-- Section Title -->
                <HorizontalStackLayout Spacing="12" Margin="0,0,0,16">
                    <Image Source="spot_purple.png"
                           WidthRequest="24"
                           HeightRequest="24"
                           VerticalOptions="Center" />
                    <Label Text="Cadastrados"
                           Style="{StaticResource TitleLarge}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>

                <!-- Venues List -->
                <CollectionView x:Name="locaisCollectionView"
                                ItemsSource="{Binding Locais}"
                                SelectionMode="None"
                                BackgroundColor="Transparent">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="contracts:EstabelecimentoListItemDto">
                            <Frame Style="{StaticResource ElevatedCard}"
                                   Margin="0,4"
                                   Padding="16">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnItemTapped" />
                                </Frame.GestureRecognizers>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <!-- Venue Name -->
                                    <Label Grid.Column="0"
                                           Text="{Binding Nome}"
                                           Style="{StaticResource TitleMedium}"
                                           VerticalOptions="Center"/>

                                    <!-- "HAS EVENTS" Badge -->
                                    <Frame Grid.Column="1"
                                           BackgroundColor="{StaticResource Error}"
                                           CornerRadius="8"
                                           Padding="8,4"
                                           IsVisible="{Binding HasEvents}"
                                           HasShadow="False"
                                           VerticalOptions="Center">
                                        <Label Text="COM EVENTOS"
                                               Style="{StaticResource LabelSmall}"
                                               TextColor="{StaticResource OnError}"
                                               FontAttributes="Bold"/>
                                    </Frame>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Empty State -->
                <Frame x:Name="emptyStateFrame"
                       IsVisible="False"
                       Style="{StaticResource FilledCard}"
                       Padding="24"
                       Margin="0,16">
                    <VerticalStackLayout Spacing="16">
                        <Label Text="Nenhum local cadastrado"
                               Style="{StaticResource TitleMedium}"
                               HorizontalOptions="Center" />
                        <Label HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               Style="{StaticResource BodyMedium}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="• Toque no botão " />
                                    <Span Text="+" TextColor="{StaticResource Tertiary}" FontAttributes="Bold" FontSize="18" />
                                    <Span Text=" no canto inferior direito para cadastrar seu primeiro local" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

        <!-- FAB (Simple Button approach - GUARANTEED to work) -->
        <Button x:Name="addFab"
                Grid.Row="1"
                Text="+"
                FontSize="32"
                FontAttributes="Bold"
                TextColor="{StaticResource OnTertiary}"
                BackgroundColor="{StaticResource Tertiary}"
                WidthRequest="56"
                HeightRequest="56"
                CornerRadius="28"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,16,16"
                Clicked="OnAddFabClicked"
                IsVisible="True"
                ZIndex="9999">
            <Button.Shadow>
                <Shadow Brush="{StaticResource Tertiary}"
                        Offset="0,4"
                        Radius="8"
                        Opacity="0.3" />
            </Button.Shadow>
        </Button>

        <!-- NAVBAR -->
        <components:CrudNavBarComponent Grid.Row="2"
                                        x:Name="CrudNavBar"
                                        SelectionCount="{Binding SelectionCount}"
                                        ButtonClicked="OnCrudNavBarButtonClicked"/>
    </Grid>
</ContentPage>
