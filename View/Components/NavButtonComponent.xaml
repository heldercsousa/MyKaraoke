<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:MyVocaList.View.Behaviors"
             xmlns:components="clr-namespace:MyVocaList.View.Components"
             x:Class="MyVocaList.View.Components.NavButtonComponent">

    <!-- ✅ BEHAVIOR: Toda a lógica de animação -->
    <ContentView.Behaviors>
        <behaviors:AnimatedButtonBehavior 
            IsAnimated="True"
            HasFadeAnimation="True" 
            HasTranslateAnimation="True"
            HasPulseAnimation="False"
            AnimationContainer="{x:Reference buttonContainer}" />
    </ContentView.Behaviors>

    <StackLayout x:Name="buttonContainer" MinimumHeightRequest="50"  MinimumWidthRequest="60">
        <StackLayout.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnButtonTapped" />
        </StackLayout.GestureRecognizers>

        <!-- OLD: PNG icons (backward compatibility) -->
        <Image x:Name="buttonIcon"
               Style="{StaticResource NavButtonIconStyle}"
               IsVisible="False" />

        <!-- NEW: MD3 SVG icons via StatefulIcon -->
        <components:StatefulIcon x:Name="buttonIconMd3"
                                  IsVisible="False" />

        <Label x:Name="buttonLabel" Style="{StaticResource NavButtonLabelStyle}" />
    </StackLayout>
</ContentView>