<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:MyVocaList.View.Components"
             x:Class="MyVocaList.View.Components.HeaderComponent"
             x:Name="HeaderRoot">

    <Grid ColumnDefinitions="Auto,*,Auto"
          BackgroundColor="{StaticResource SurfaceContainer}"
          Padding="16,12,16,12"
          RowSpacing="0"
          ColumnSpacing="8"
          HeightRequest="64">
        <Grid Grid.Column="0"
              WidthRequest="48"
              HeightRequest="48"
              HorizontalOptions="Start"
              VerticalOptions="Center">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnLeftButtonClicked" />
            </Grid.GestureRecognizers>

            <components:StatefulIcon x:Name="backArrowImage"
                                   IconName="arrow_back"
                                   IsVisible="True"/>

            <components:StatefulIcon x:Name="cancelIconImage"
                                   IconName="close"
                                   IsVisible="False"/>

            <Label x:Name="cancelTextLabel"
                   Text="Cancel"
                   Style="{StaticResource LabelLarge}"
                   TextColor="{StaticResource OnSurfaceVariant}"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"
                   LineBreakMode="NoWrap"
                   IsVisible="False" />
        </Grid>

        <Label Grid.Column="1"
               x:Name="headerTitle"
               Text="{Binding Source={x:Reference HeaderRoot}, Path=Title}"
               Style="{StaticResource TitleLarge}"
               TextColor="{StaticResource OnSurface}"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               LineBreakMode="TailTruncation" />

        <Frame Grid.Column="2"
               x:Name="rightButtonStack"
               WidthRequest="40"
               HeightRequest="40"
               BackgroundColor="{StaticResource Primary}"
               CornerRadius="20"
               Padding="0"
               HasShadow="False"
               BorderColor="Transparent"
               HorizontalOptions="End"
               VerticalOptions="Center"
               IsVisible="False">

            <Frame.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnSaveButtonClicked" />
            </Frame.GestureRecognizers>

            <Grid>
                <components:StatefulIcon x:Name="saveIconImage"
                                       IconName="check"
                                       InactiveColor="{StaticResource OnPrimary}"
                                       IsVisible="False"
                                       VerticalOptions="Center"
                                       HorizontalOptions="Center" />

                <Label x:Name="saveTextLabel"
                       Text="Save"
                       TextColor="{StaticResource OnPrimary}"
                       Style="{StaticResource LabelLarge}"
                       VerticalOptions="Center"
                       HorizontalOptions="Center"
                       IsVisible="False" />
            </Grid>

        </Frame>

        <ContentView Grid.Column="2"
                     x:Name="rightSpacer"
                     WidthRequest="48"
                     IsVisible="True" />

    </Grid>
</ContentView>