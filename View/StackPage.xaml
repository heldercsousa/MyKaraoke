<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:MyVocaList.View.Components"
             xmlns:local="clr-namespace:MyVocaList.View"
             xmlns:behaviors="clr-namespace:MyVocaList.View.Behaviors"
             x:Class="MyVocaList.View.StackPage"
             x:DataType="local:StackPage"
             Background="{StaticResource Background}"
             NavigationPage.HasNavigationBar="False">

    <!-- ✅ APENAS SmartPageLifecycleBehavior - SEM SafeNavigationBehavior -->
    <!-- StackPage é página principal - HeaderComponent sairá da aplicação -->
    <ContentPage.Behaviors>
        <behaviors:SmartPageLifecycleBehavior 
            NavBar="{x:Reference bottomNav}"
            MainContent="{x:Reference mainContentGrid}"
            LoadDataCommand="{Binding LoadDataCommand}"
            EnableAutoBypass="True"
            MaxFailuresBeforeBypass="2" />
    </ContentPage.Behaviors>

    <Grid Padding="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header Component -->
        <components:HeaderComponent Grid.Row="0"
                           x:Name="headerComponent"
                           Title="Queue"
                           ExitApp="True" />

        <!-- Card usando CardWrapperComponent -->
        <Grid Grid.Row="1" x:Name="mainContentGrid">
            <components:CardWrapperComponent TitleText="Fila" 
                                           IconPath="stack_purple.png" 
                                           BadgeIsVisible="True"
                                           BadgeText="{Binding QueueStatusText}">
                <components:CardWrapperComponent.CardContent>
                    <Grid RowDefinitions="*">
                        <!-- Empty queue message - MD3 Light -->
                        <Frame x:Name="emptyQueueMessage"
                               IsVisible="True"
                               VerticalOptions="Start"
                               Style="{StaticResource FilledCard}"
                               Padding="24"
                               Margin="0,16">

                            <VerticalStackLayout Spacing="16">
                                <!-- Title -->
                                <Label Text="No active queue"
                                       Style="{StaticResource TitleMedium}"
                                       TextColor="{StaticResource OnSurfaceVariant}"
                                       HorizontalOptions="Center" />

                                <!-- Instructions -->
                                <VerticalStackLayout Spacing="12">
                                    <!-- Instruction 1 -->
                                    <Label Style="{StaticResource BodyMedium}"
                                           TextColor="{StaticResource OnSurfaceVariant}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="• Touch " />
                                                <Span Text="New Queue" TextColor="{StaticResource Primary}" FontAttributes="Bold" />
                                                <Span Text=" button to start adding singers to the karaoke" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <!-- Instruction 2 -->
                                    <Label Style="{StaticResource BodyMedium}"
                                           TextColor="{StaticResource OnSurfaceVariant}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="• " />
                                                <Span Text="Reactivate" TextColor="{StaticResource Primary}" FontAttributes="Bold" />
                                                <Span Text=" the last queue by entering the " />
                                                <Span Text="History" TextColor="{StaticResource Primary}" FontAttributes="Bold" />
                                                <Span Text=" option below" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Frame>

                        <!-- Active queue content - MD3 Light -->
                        <CollectionView x:Name="filaCollectionView"
                                        SelectionMode="None"
                                        IsVisible="False"
                                        BackgroundColor="Transparent">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8"/>
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="{x:Null}">
                                    <Frame Style="{StaticResource ElevatedCard}"
                                           Padding="16"
                                           Margin="0,4">
                                        <Grid ColumnDefinitions="*, Auto, Auto, Auto"
                                              ColumnSpacing="8">
                                            <!-- Singer Info -->
                                            <VerticalStackLayout Grid.Column="0"
                                                               VerticalOptions="Center"
                                                               Spacing="4">
                                                <Label Text="{Binding NomeCompleto}"
                                                       Style="{StaticResource TitleMedium}"
                                                       TextColor="{StaticResource OnSurface}"/>
                                                <Label Text="{Binding NumeroParticipacoesAusencias}"
                                                       Style="{StaticResource BodySmall}"
                                                       TextColor="{StaticResource OnSurfaceVariant}"/>
                                            </VerticalStackLayout>

                                            <!-- Participated Button (Success) -->
                                            <Button Text="✓"
                                                    Clicked="OnParticipouClicked"
                                                    CommandParameter="{Binding .}"
                                                    Grid.Column="1"
                                                    WidthRequest="48"
                                                    HeightRequest="48"
                                                    CornerRadius="24"
                                                    BackgroundColor="{StaticResource Success}"
                                                    TextColor="{StaticResource OnSuccess}"
                                                    FontSize="20"
                                                    FontAttributes="Bold"
                                                    VerticalOptions="Center"
                                                    Padding="0"/>

                                            <!-- Absent Button (Error) -->
                                            <Button Text="✕"
                                                    Clicked="OnAusenteClicked"
                                                    CommandParameter="{Binding .}"
                                                    Grid.Column="2"
                                                    WidthRequest="48"
                                                    HeightRequest="48"
                                                    CornerRadius="24"
                                                    BackgroundColor="{StaticResource Error}"
                                                    TextColor="{StaticResource OnError}"
                                                    FontSize="20"
                                                    FontAttributes="Bold"
                                                    VerticalOptions="Center"
                                                    Padding="0"/>

                                            <!-- Move to Bottom Button (Tonal) -->
                                            <Button Text="↓"
                                                    Clicked="OnMoveToBottomClicked"
                                                    CommandParameter="{Binding .}"
                                                    Grid.Column="3"
                                                    WidthRequest="48"
                                                    HeightRequest="48"
                                                    CornerRadius="24"
                                                    BackgroundColor="{StaticResource SurfaceVariant}"
                                                    TextColor="{StaticResource OnSurfaceVariant}"
                                                    FontSize="20"
                                                    FontAttributes="Bold"
                                                    VerticalOptions="Center"
                                                    Padding="0"/>
                                        </Grid>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                </components:CardWrapperComponent.CardContent>
            </components:CardWrapperComponent>

        </Grid>

        <!-- ✅ InactiveQueueBottomNav com navegação interna -->
        <components:InactiveQueueBottomNav Grid.Row="2" 
                                         x:Name="bottomNav" 
                                         IsVisible="True" />
    </Grid>

</ContentPage>