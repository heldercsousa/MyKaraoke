<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyKaraoke.View.Components.SnackbarComponent"
             x:Name="SnackbarRoot"
             IsVisible="False"
             HorizontalOptions="Fill"
             VerticalOptions="End">
    
    <Frame x:Name="SnackbarFrame"
           Style="{StaticResource SnackbarContainerStyle}"
           TranslationY="100">
        
        <Grid ColumnDefinitions="Auto,*">
            <!-- Ícone -->
            <Image x:Name="IconImage"
                   Grid.Column="0"
                   Style="{StaticResource SnackbarIconStyle}" />
            
            <!-- Mensagem -->
            <Label x:Name="MessageLabel"
                   Grid.Column="1"
                   Style="{StaticResource SnackbarTextStyle}" />
        </Grid>
    </Frame>
</ContentView>