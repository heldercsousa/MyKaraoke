<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:MyVocaList.View.Components"
             x:Class="MyVocaList.View.Components.HeaderComponent"
             x:Name="HeaderRoot">

    <Grid ColumnDefinitions="Auto,*,Auto"
          Padding="16,12,16,12"
          RowSpacing="0"
          ColumnSpacing="8">

        <!-- LEFT BUTTON CONTAINER (48x48dp MD3 Touch Target) -->
        <Grid Grid.Column="0"
              WidthRequest="48"
              HeightRequest="48"
              HorizontalOptions="Start"
              VerticalOptions="Center">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnLeftButtonClicked" />
            </Grid.GestureRecognizers>

            <!-- Back Arrow (List Mode) -->
            <components:StatefulIcon x:Name="backArrowImage"
                   IconName="arrow_back"
                   IsVisible="True"/>

            <!-- Cancel Icon (Form Mode with Icon) -->
            <components:StatefulIcon x:Name="cancelIconImage"
                   IconName="close"
                   IsVisible="False"/>

            <!-- Cancel Text (Form Mode with Text) -->
            <Label x:Name="cancelTextLabel"
                   Text="Cancel"
                   TextColor="{StaticResource OnSurfaceVariant}"
                   FontSize="16"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"
                   LineBreakMode="NoWrap"
                   IsVisible="False" />
        </Grid>

        <!-- Title (Centered, No Icon - MD3 Recommended) -->
        <Label Grid.Column="1"
               x:Name="headerTitle"
               Text="{Binding Source={x:Reference HeaderRoot}, Path=Title}"
               Style="{StaticResource HeadlineMedium}"
               TextColor="{StaticResource OnBackground}"
               HorizontalOptions="Center"
               VerticalOptions="Center" />



        <Frame Grid.Column="2"
       x:Name="rightButtonStack"
       WidthRequest="48"
       HeightRequest="48"
       BackgroundColor="{StaticResource Primary}"
       CornerRadius="24" Padding="0"
       HasShadow="False"
       HorizontalOptions="End"
       VerticalOptions="Center"
       IsVisible="False">

            <Frame.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnSaveButtonClicked" />
            </Frame.GestureRecognizers>

            <Grid>
                <components:StatefulIcon x:Name="saveIconImage"
               IconName="check"
               InactiveColor="{StaticResource OnPrimary}" IsVisible="False"
               VerticalOptions="Center"
               HorizontalOptions="Center" />

                <Label x:Name="saveTextLabel"
               Text="Save"
               TextColor="{StaticResource OnPrimary}" FontSize="16"
               FontAttributes="Bold"
               VerticalOptions="Center"
               HorizontalOptions="Center"
               IsVisible="False" />
            </Grid>

        </Frame>

        <!-- SPACER (When no right button is shown) -->
        <ContentView Grid.Column="2"
                     x:Name="rightSpacer"
                     WidthRequest="48"
                     IsVisible="True" />

    </Grid>
</ContentView>
