# ============================================
# .claudeignore - MyVocaList
# ============================================

# Standard .NET build artifacts
[Bb]in/
[Oo]bj/

# Visual Studio files
.vs/
.suo
*.user
*.usercode
*.resharper
*.resharper.user
*.resharper.[a-z0-9]*
*.cache
*.swo
*.stash
*.nvcrunch

# Package files
*.nupkg
*.snupkg
[Pp]ackages/
# except packages folder in the root, which is used as an MSBuild target
!**/packages/build/
!**/packages/repositories/
!**/packages/config

# Temporary files and logs
temp/
*[Tt]emp/
*.log
*.tlog
*.sdf
*.vssscc
*.stackdump
*.aps
*.ncb
*.opensdf
*.VC.db
*.VC.opendb

# Misc other files
[Dd]ebug/
[Rr]elease/
publish/
build/
install/
artifact/
artifacts/

# OS-specific files
.DS_Store
.idea/

# Secret and credential files (essential for security)
*.env
*.pem
*.key
**/secrets/
**/credentials/

# MAUI specific files (build outputs, etc.)
*.apk
*.aab
*.ipa
*.app
*.exe
*.dll
*.pdb
*.winmd
*.pri
*.appx
*.appxbundle
*.msix
*.msixbundle
*.vsix
*.xap
*.xaml.g.cs
*.xaml.g.vb
*.designer.cs
*.designer.vb
*.datasource
*.android.js
*.android.txt
*.android.rc
*.ios.js
*.ios.txt
*.ios.rc
*.windows.js
*.windows.txt
*.windows.rc
# deobfuscation files (optional, can be useful for debugging)
proguard_logs/
# Native code build outputs
*.so
*.dylib
*.dll.config

# Rider files
.idea/

# VS Code files
.vscode/

# VS files
*.code-workspace
*.vs/
dotnet-tools.json

# Auto generated files (if you don't want Claude to modify them)
**/Migrations/  # Se não quer que Claude mexa em migrations antigas
**/wwwroot/lib/  # Bibliotecas de terceiros no wwwroot

# Performance and load test results
**/TestResults/
**/*.trx

# If there are large test datasets/files
**/TestData/**/*.json
**/TestData/**/*.xml
**/TestData/**/*.csv


# Hiding the .claudeignore file itself can sometimes be helpful for certain AI tools
# .claudeignore

# Metadata files (not needed by Claude Code)
.gitignore              
.gitattributes          
.editorconfig           

# Console Projects folders - usually not needed for AI analysis since they´re just tools used once in a while and no other code depends on them
Console/**

# Large documentation files (PDFs, Word docs, Images, etc.) when not needed
**/[Dd]ocs/**/*.pdf
**/[Dd]ocs/**/*.docx
**/[Dd]ocs/**/*.png
**/[Dd]ocs/**/*.jpg
**/[Dd]ocs/**/*.jpeg
**/[Dd]ocs/**/*.gif
**/[Dd]ocs/**/*.svg
**/[Dd]ocs/[Cc]hangelog/[Aa]rchive/**
**/[Dd]ocs/[Ss]ocial [Nn]etworks/**
**/[Dd]ocs/[Gg]uides/**             
![Dd]ocs/[Gg]uides/MyVocalist_migration_material_design_guide.md  # EXCETO este!
**/[Vv]iew/Resources/AppIcon/*.resx
**[Vv]iew/Resources/**/*.png
**[Vv]iew/Resources/**/*.jpg
**[Vv]iew/Resources/**/*.jpeg
**[Vv]iew/Resources/**/*.gif
**[Vv]iew/Resources/Fonts/**/*.ttf
**[Vv]iew/Resources/Strings/**/*.resx

# Batch files
*.bat
