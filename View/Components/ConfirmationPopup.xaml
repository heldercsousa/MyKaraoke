<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="MyVocaList.View.Components.ConfirmationPopup"
               Color="Transparent">

    <Grid RowDefinitions="Auto"
          ColumnDefinitions="Auto"
          VerticalOptions="Center"
          HorizontalOptions="Center">

        <Frame Style="{StaticResource ElevatedCard}"
               WidthRequest="300"
               Padding="24"
               CornerRadius="28"
               HasShadow="True"
               VerticalOptions="Start"
               HorizontalOptions="Center">

            <VerticalStackLayout Spacing="16">

                <Label x:Name="titleLabel"
                       Style="{StaticResource HeadlineSmall}"
                       TextColor="{StaticResource OnSurface}"
                       HorizontalOptions="Start" />

                <Label x:Name="messageLabel"
                       Style="{StaticResource BodyMedium}"
                       TextColor="{StaticResource OnSurfaceVariant}"
                       HorizontalOptions="Start"
                       LineBreakMode="WordWrap" />

                <HorizontalStackLayout Spacing="12"
                                       HorizontalOptions="End"
                                       Margin="0,8,0,0">

                    <Button x:Name="cancelButton"
                            Text="Cancel"
                            Style="{StaticResource TextButton}"
                            Clicked="OnCancelClicked"
                            MinimumWidthRequest="80" />

                    <Button x:Name="confirmButton"
                            Text="Confirm"
                            Style="{StaticResource FilledDestructiveButton}"
                            Clicked="OnConfirmClicked"
                            MinimumWidthRequest="80" />

                </HorizontalStackLayout>

            </VerticalStackLayout>

        </Frame>
    </Grid>

</toolkit:Popup>
