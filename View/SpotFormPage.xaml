<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:MyVocaList.View.Components"
             xmlns:behaviors="clr-namespace:MyVocaList.View.Behaviors"
             xmlns:local="clr-namespace:MyVocaList.View"
             x:Class="MyVocaList.View.SpotFormPage"
             x:DataType="local:SpotFormPage"
             Background="{StaticResource Background}"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Behaviors>
        <behaviors:SmartPageLifecycleBehavior
            LoadDataCommand="{Binding LoadDataCommand}"
            EnableAutoBypass="True"
            MaxFailuresBeforeBypass="2" />

        <behaviors:SafeNavigationBehavior
            x:Name="BackNavigationBehavior"
            EnableSmartStackNavigation="True"
            DebounceMilliseconds="500" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,*">

        <components:HeaderComponent Grid.Row="0"
                                   x:Name="headerComponent"
                                   Title="New Venue"
                                   ShowCancelButton="True"
                                   ShowSaveButton="True"
                                   UseCancelIcon="True"
                                   UseSaveIcon="True"
                                   CancelClicked="OnCancelClicked"
                                   SaveClicked="OnSaveClicked"/>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout x:Name="mainContentStack"
                               Style="{StaticResource PageContainer}">

                <components:MaterialEntryComponent 
                    x:Name="nomeLocalInput"
                    Title="Venue name"
                    Placeholder="Enter venue name"
                    MaxLength="30"
                    TextChanged="OnNomeLocalTextChanged" />


            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>