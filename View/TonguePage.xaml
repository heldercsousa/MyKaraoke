<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:MyVocaList.View.Components"
             xmlns:behaviors="clr-namespace:MyVocaList.View.Behaviors"
             xmlns:local="clr-namespace:MyVocaList.View"
             x:Class="MyVocaList.View.TonguePage"
             x:DataType="local:TonguePage"
             Background="{StaticResource Background}"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Behaviors>
        <behaviors:SmartPageLifecycleBehavior
            LoadDataCommand="{Binding LoadDataCommand}"
            EnableAutoBypass="True"
            MaxFailuresBeforeBypass="2" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,*">

        <components:HeaderComponent Grid.Row="0"
                                   x:Name="headerComponent"
                                   Title="Language"
                                   ShowCancelButton="True"
                                   ShowSaveButton="True"
                                   UseCancelIcon="True"
                                   UseSaveIcon="True"
                                   CancelClicked="OnCancelClicked"
                                   SaveClicked="OnSaveClicked"/>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Languages}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedLanguageItem, Mode=TwoWay}"
                        SelectionChangedCommand="{Binding LanguageSelectedCommand}"
                        VerticalOptions="FillAndExpand">
            
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:LanguageItem">
                    <VerticalStackLayout Spacing="0">
                        <Frame Style="{StaticResource ElevatedCard}"
                               Padding="16,12"
                               HasShadow="False">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type local:TonguePage}}, Path=LanguageSelectedCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Frame.GestureRecognizers>

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualState Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Property="BorderColor" Value="Transparent" />
                                            <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="BorderColor" Value="{StaticResource Primary}" />
                                            <Setter Property="BackgroundColor" Value="{StaticResource SecondaryContainer}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                <!-- Flag -->
                                <Label Grid.Column="0"
                                       Text="{Binding Flag}"
                                       FontSize="24"
                                       VerticalOptions="Center" />

                                <!-- Name -->
                                <Label Grid.Column="1"
                                       Text="{Binding Name}"
                                       Style="{StaticResource TitleMedium}"
                                       VerticalOptions="Center" />

                                <!-- Checkmark (Visible only when selected) -->
                                <Label Grid.Column="2"
                                       Text="✓"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}"
                                       IsVisible="{Binding IsSelected}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Frame>

                        <!-- MD3 Divider (72dp left margin aligns with flag icons) -->
                        <BoxView HeightRequest="1"
                                 Color="{StaticResource OnSurfaceVariant}"
                                 Opacity="0.12"
                                 Margin="72,0,16,0"
                                 HorizontalOptions="FillAndExpand" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>