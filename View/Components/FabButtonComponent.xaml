<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MyVocaList.View.Components.FabButtonComponent"
             x:Name="fabRoot">

    <!-- MD3 FAB (Floating Action Button) -->
    <ImageButton x:Name="fabButton"
                 Source="add_outlined"
                 BackgroundColor="{StaticResource PrimaryContainer}"
                 CornerRadius="16"
                 WidthRequest="56"
                 HeightRequest="56"
                 Padding="16"
                 HorizontalOptions="End"
                 VerticalOptions="End"
                 Margin="0,0,16,16"
                 Clicked="OnFabClicked"
                 IsVisible="True"
                 Aspect="AspectFit">
        <ImageButton.Behaviors>
            <toolkit:IconTintColorBehavior TintColor="{StaticResource OnPrimaryContainer}" />
        </ImageButton.Behaviors>
        <ImageButton.Shadow>
            <Shadow Brush="{StaticResource Shadow}" Offset="0,4" Radius="8" Opacity="0.4" />
        </ImageButton.Shadow>
    </ImageButton>

</ContentView>