    <!-- ============================================================================ -->
    <!-- GRADIENTS (Using Tonal Palette Values - Light Theme)                       -->
    <!-- ============================================================================ -->

    <!-- Primary Purple Gradient (Light - for cards/highlights) -->
    <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Primary90}" Offset="0.0" />
        <GradientStop Color="{StaticResource Primary80}" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Secondary Teal Gradient (Light - for cards/highlights) -->
    <LinearGradientBrush x:Key="SecondaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Secondary90}" Offset="0.0" />
        <GradientStop Color="{StaticResource Secondary80}" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Tertiary Orange Gradient (for special actions/FAB) -->
    <LinearGradientBrush x:Key="TertiaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Tertiary70}" Offset="0.0" />
        <GradientStop Color="{StaticResource Tertiary60}" Offset="1.0" />
    </LinearGradientBrush>

    <!-- FAB Gradient (Orange accent - highly visible) -->
    <LinearGradientBrush x:Key="FabGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Tertiary70}" Offset="0.0" />
        <GradientStop Color="{StaticResource Tertiary50}" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Card Background Gradient (Subtle purple tint) -->
    <LinearGradientBrush x:Key="CardBackgroundGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource PrimaryContainer}" Offset="0.0" />
        <GradientStop Color="{StaticResource Surface}" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Background Gradient (Subtle page background) -->
    <LinearGradientBrush x:Key="AppBackgroundGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource Background}" Offset="0.0" />
        <GradientStop Color="{StaticResource SurfaceContainerLow}" Offset="1.0" />
    </LinearGradientBrush>

    <!-- ============================================================================ -->
    <!-- SEMANTIC COLORS (For Specific Use Cases)                                   -->
    <!-- ============================================================================ -->

    <!-- Success (for positive feedback) -->
    <Color x:Key="Success">#FF4CAF50</Color>
    <Color x:Key="OnSuccess">#FFFFFFFF</Color>

    <!-- Warning (for caution states) -->
    <Color x:Key="Warning">#FFFF9800</Color>
    <Color x:Key="OnWarning">#FF000000</Color>

    <!-- Info (for informational elements) -->
    <Color x:Key="Info">#FF2196F3</Color>
    <Color x:Key="OnInfo">#FFFFFFFF</Color>
