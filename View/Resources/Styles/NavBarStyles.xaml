<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ============================================================================ -->
    <!-- 🔥 BOTTOM NAVIGATION BAR STYLES - MATERIAL DESIGN 3 COMPLIANT -->
    <!-- ============================================================================ -->

    <!-- Base Bottom Navigation Bar Frame - MD3 Light Theme -->
    <Style x:Key="BaseBottomNavBarStyle" TargetType="Frame">
        <!-- MD3 Standard Bottom Nav Background -->
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceContainer}" />
        <!-- Top Border as Divider -->
        <Setter Property="BorderColor" Value="{StaticResource OutlineVariant}" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="HasShadow" Value="False" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <!-- MD3 Standard Height is 80dp -->
        <Setter Property="HeightRequest" Value="80" />
        <Setter Property="VerticalOptions" Value="End" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{StaticResource Shadow}" Offset="0,-2" Radius="8" Opacity="0.1" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Compact version (same as base but explicit) -->
    <Style x:Key="CompactBottomNavBarStyle" TargetType="Frame" BasedOn="{StaticResource BaseBottomNavBarStyle}">
        <!-- Inherits all properties from base -->
    </Style>

    <!-- Legacy style for compatibility -->
    <Style x:Key="BottomNavigationBarStyle" TargetType="Frame" BasedOn="{StaticResource BaseBottomNavBarStyle}">
        <!-- Inherits all properties from base -->
    </Style>

    <!-- ============================================================================ -->
    <!-- 🔥 BOTTOM NAVIGATION BUTTON STYLES -->
    <!-- ============================================================================ -->

    <!-- Base Button Style for all navbar buttons -->
    <Style x:Key="BaseNavButtonStyle" TargetType="StackLayout">
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="Spacing" Value="4" />
        <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- Regular Icon Button Style -->
    <Style x:Key="NavButtonIconStyle" TargetType="Image">
        <Setter Property="WidthRequest" Value="24" />
        <Setter Property="HeightRequest" Value="24" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Start" />
        <!-- Adjusted margins for 80dp height -->
        <Setter Property="Margin" Value="0,12,0,4" />
    </Style>

    <!-- Label Style for navbar buttons -->
    <Style x:Key="NavButtonLabelStyle" TargetType="Label">
        <!-- MD3 Label Medium: 12sp, Medium Weight -->
        <!-- Using OnSurface for high visibility (Active state approximation) -->
        <Setter Property="TextColor" Value="{StaticResource OnSurface}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="End" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- Compact versions (aliases for compatibility) -->
    <Style x:Key="CompactBottomNavIconStyle" TargetType="Image" BasedOn="{StaticResource NavButtonIconStyle}">
        <!-- Inherits all properties -->
    </Style>

    <Style x:Key="CompactBottomNavLabelStyle" TargetType="Label" BasedOn="{StaticResource NavButtonLabelStyle}">
        <!-- Inherits all properties -->
    </Style>

    <Style x:Key="CompactNavIconStyle" TargetType="Image" BasedOn="{StaticResource NavButtonIconStyle}">
        <!-- Inherits all properties -->
    </Style>

    <Style x:Key="CompactNavLabelStyle" TargetType="Label" BasedOn="{StaticResource NavButtonLabelStyle}">
        <!-- Inherits all properties -->
    </Style>

    <!-- Legacy styles for compatibility -->
    <Style x:Key="BottomNavIconStyle" TargetType="Image" BasedOn="{StaticResource NavButtonIconStyle}">
        <Setter Property="Margin" Value="0,12,0,4" />
    </Style>

    <Style x:Key="BottomNavButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource OnSurfaceVariant}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="VerticalOptions" Value="Fill" />
    </Style>

    <!-- ============================================================================ -->
    <!-- 🔥 SPECIAL BUTTON STYLES (Nova Fila, etc.) - NOW USING MD3 TERTIARY -->
    <!-- ============================================================================ -->

    <!-- Special Button Container (for buttons like Nova Fila) -->
    <Style x:Key="SpecialNavButtonStyle" TargetType="StackLayout" BasedOn="{StaticResource BaseNavButtonStyle}">
        <Setter Property="Spacing" Value="2" />
    </Style>

    <!-- ✅ RENAMED: TertiaryGradientFrameStyle (was YellowGradientFrameStyle) -->
    <!-- Now uses MD3 TertiaryGradient (Orange #F57C00) from MaterialColors.xaml -->
    <Style x:Key="TertiaryGradientFrameStyle" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderColor" Value="Transparent" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="WidthRequest" Value="64" />
        <Setter Property="HeightRequest" Value="32" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HasShadow" Value="False" />
        <!-- ✅ FIXED: Using MD3 TertiaryGradient instead of hardcoded gold colors -->
        <Setter Property="Background" Value="{StaticResource TertiaryGradient}" />
        <Setter Property="Shadow">
            <Setter.Value>
                <!-- ✅ FIXED: Using MD3 Tertiary color for shadow -->
                <Shadow Brush="{StaticResource Tertiary}" Offset="0,2" Radius="8" Opacity="0.3" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ✅ BACKWARD COMPATIBILITY: Alias for old name -->
    <Style x:Key="YellowGradientFrameStyle" TargetType="Frame" BasedOn="{StaticResource TertiaryGradientFrameStyle}">
        <!-- Inherits all properties - allows existing code to work without changes -->
    </Style>

    <!-- ✅ REMOVED: OrangeGradientFrameStyle -->
    <!-- No longer needed - was duplicate of TertiaryGradientFrameStyle -->
    <!-- Old references should use TertiaryGradientFrameStyle directly -->

    <!-- Plus Label Style (for + symbol in special buttons) -->
    <Style x:Key="PlusLabelStyle" TargetType="Label">
        <Setter Property="Text" Value="+" />
        <!-- ✅ FIXED: Using MD3 OnTertiary instead of hardcoded #1A1024 -->
        <Setter Property="TextColor" Value="{StaticResource OnTertiary}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <!-- Custom Icon Label Style (for custom symbols in special buttons) -->
    <Style x:Key="SpecialButtonIconLabelStyle" TargetType="Label" BasedOn="{StaticResource PlusLabelStyle}">
        <Setter Property="Text" Value="" />
        <Setter Property="FontSize" Value="18" />
    </Style>

    <!-- ============================================================================ -->
    <!-- 🔥 ANIMATION STATE STYLES -->
    <!-- ============================================================================ -->

    <!-- Hidden state for show/hide animations -->
    <Style x:Key="NavButtonHiddenStyle" TargetType="StackLayout" BasedOn="{StaticResource BaseNavButtonStyle}">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="TranslationY" Value="20" />
    </Style>

    <!-- Visible state for show/hide animations -->
    <Style x:Key="NavButtonVisibleStyle" TargetType="StackLayout" BasedOn="{StaticResource BaseNavButtonStyle}">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="TranslationY" Value="0" />
    </Style>

    <!-- Pressed state for tap animations -->
    <Style x:Key="NavButtonPressedStyle" TargetType="StackLayout" BasedOn="{StaticResource BaseNavButtonStyle}">
        <Setter Property="Scale" Value="0.95" />
        <Setter Property="Opacity" Value="0.8" />
    </Style>

</ResourceDictionary>